# Copy to .env.local and fill in. All keys are optional — the app gracefully
# simulates responses when they are missing.

# Groq API key — used by /api/generate-marketing to draft MLS / social / email copy.
# Get a free key at console.groq.com (no credit card required).
GROQ_API_KEY=

# Resend API key — used by /api/notify-team to send new-listing email notifications.
RESEND_API_KEY=

# Where the "team notified" email goes. Defaults to team@localpro.example.
TEAM_EMAIL=team@example.com
